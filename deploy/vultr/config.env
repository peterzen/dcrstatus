# Deployment parameters. Every value can be overridden from the environment, e.g.
#   LABEL=is-decred REGION=atl ./deploy.sh
: "${LABEL:=is-decred}"          # name of instance; firewall group = $LABEL, block volume = $LABEL-srv
: "${FQDN:=is.decred.online}"    # hostname baked into the OS (SERVER_URL for Caddy lives in .env)
: "${REGION:=atl}"
: "${PLAN:=vc2-2c-4gb}"          # 2 vCPU / 4 GB / 80 GB
: "${OS_ID:=2625}"               # Debian 13 x64 (trixie)
: "${BLOCK_TYPE:=high_perf}"     # NVMe; some regions (e.g. mia) only offer storage_opt (HDD, 40 GB min)
: "${BLOCK_GB:=20}"              # becomes ZFS pool "tank" mounted at /srv
# VULTR            command that calls the Vultr API: `$VULTR METHOD /endpoint [json]` (default: vultr on PATH)
# SSH_AUTHORIZED_KEYS_FILE  public keys to install for root (required by deploy.sh)
